EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.replace-with-a-dedicated-public-token
EXPO_PUBLIC_CESIUM_VIEWER_URL=https://example.com/exploration/
# Optional Android fallback. Restrict to Maps SDK for Android and the app signing certificate.
EXPO_PUBLIC_ANDROID_GOOGLE_MAPS_API_KEY=
# Restrict to Maps SDK for iOS and the iOS app bundle identifier.
EXPO_PUBLIC_IOS_GOOGLE_MAPS_API_KEY=
